---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
import { CATEGORIES, APPROACHES } from '../data/taxonomy';

const CONTACT_EMAIL = 'emailguideproject@gmail.com';
---

<Base title="Submit an email — Email Library">
  <a href={withBase('')} class="text-sm text-gray-500 hover:underline">&larr; Back to all emails</a>

  <h1 class="mt-4 text-3xl font-semibold">Submit an email</h1>
  <p class="mt-2 max-w-2xl text-gray-600">
    Share an email you sent that got a reply: a cold email, internship inquiry, or podcast/event
    invite. All personal information is censored before publishing.
  </p>

  <div class="mt-4 rounded-lg border border-gray-200 bg-gray-50 p-4 text-sm text-gray-700">
    Prefer not to fill out a form? Forward the email directly to
    <a class="underline" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and mention you'd like
    it added.
  </div>

  <form id="submit-form" novalidate class="mt-8 space-y-6">
    <div class="hp-field" aria-hidden="true">
      <label for="botcheck">Leave this field empty</label>
      <input type="text" id="botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
    </div>

    <div class="field">
      <label for="category" class="field-label">Category</label>
      <select id="category" name="category" data-required="true" class="field-input">
        <option value="" selected disabled>Choose one&hellip;</option>
        {CATEGORIES.map((c) => <option value={c.slug}>{c.label}</option>)}
      </select>
      <p id="category-error" class="field-error"></p>
    </div>

    <div class="field">
      <label for="priorContact" class="field-label">Your connection to the recipient</label>
      <select id="priorContact" name="priorContact" data-required="true" class="field-input">
        <option value="" selected disabled>Choose one&hellip;</option>
        {APPROACHES.map((a) => <option value={a.slug}>{a.label}</option>)}
      </select>
      <p id="priorContact-error" class="field-error"></p>
    </div>

    <div class="field">
      <label for="emailSubject" class="field-label">Subject line</label>
      <input
        type="text"
        id="emailSubject"
        name="emailSubject"
        data-required="true"
        class="field-input"
      />
      <p id="emailSubject-error" class="field-error"></p>
    </div>

    <div class="redaction-guidance">
      <p class="redaction-guidance-title">Pasting your email</p>
      <p class="mt-1">
        You're welcome to censor identifying details yourself (names, institutions, talk titles)
        before pasting, or we can do it for you before publishing. We will never publish replies
        verbatim.
      </p>
    </div>

    <div class="field">
      <label for="body" class="field-label">Email body</label>
      <textarea
        id="body"
        name="body"
        data-required="true"
        rows="14"
        class="field-input font-body"
      ></textarea>
      <p id="body-error" class="field-error"></p>
    </div>

    <div class="field">
      <label for="displayName" class="field-label">Name <span class="field-optional">(optional)</span></label>
      <p class="field-hint">If you want your email attributed to you. Otherwise, leave blank.</p>
      <input type="text" id="displayName" name="displayName" class="field-input" />
    </div>

    <div class="field">
      <label for="submitterEmail" class="field-label">Your email</label>
      <p class="field-hint">So I can follow up if I have questions about edits.</p>
      <input type="email" id="submitterEmail" name="submitterEmail" data-required="true" class="field-input" />
      <p id="submitterEmail-error" class="field-error"></p>
    </div>

    <div class="consent-block">
      <label class="consent-item">
        <input type="checkbox" name="consentSentMyself" data-required="true" />
        I sent this email myself.
      </label>
      <label class="consent-item">
        <input type="checkbox" name="consentPublish" data-required="true" />
        I'm okay with it being published along with annotations, with identifying details replaced.
      </label>
      <label class="consent-item">
        <input type="checkbox" name="consentEdited" data-required="true" />
        I understand it may be edited and annotated before publishing.
      </label>
      <label class="consent-item">
        <input type="checkbox" name="consentRemoval" data-required="true" />
        I understand I can ask to have this removed later by emailing {CONTACT_EMAIL}.
      </label>
      <p id="consent-error" class="field-error"></p>
    </div>

    <div>
      <button type="submit" class="submit-button">Submit</button>
      <p id="form-status" class="form-status" role="status"></p>
    </div>
  </form>
</Base>

<style>
  .field {
    display: block;
  }
  .field-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
  }
  .field-optional {
    font-weight: 400;
    color: #6b7280;
  }
  .field-hint {
    margin-top: 0.125rem;
    font-size: 0.75rem;
    color: #6b7280;
  }
  .field-input {
    margin-top: 0.375rem;
    display: block;
    width: 100%;
    border-radius: 0.375rem;
    border: 1px solid #d1d5db;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: #111827;
  }
  .field-input:focus {
    outline: none;
    border-color: #111827;
  }
  .field-input.field-invalid {
    border-color: #dc2626;
  }
  .field-error {
    margin-top: 0.25rem;
    min-height: 1em;
    font-size: 0.75rem;
    color: #dc2626;
  }
  .font-body {
    font-family: Arial, Helvetica, sans-serif;
  }

  .redaction-guidance {
    border: 1px solid #fde68a;
    background: #fffbeb;
    border-radius: 0.5rem;
    padding: 1rem;
    font-size: 0.875rem;
    color: #78350f;
  }
  .redaction-guidance-title {
    font-weight: 600;
  }

  .consent-block {
    border-top: 1px solid #e5e7eb;
    padding-top: 1rem;
  }
  .consent-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #374151;
    margin-top: 0.75rem;
  }
  .consent-item:first-child {
    margin-top: 0;
  }
  .consent-item input {
    margin-top: 0.1875rem;
  }

  .submit-button {
    border-radius: 9999px;
    background: #111827;
    color: white;
    padding: 0.5rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }
  .submit-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .form-status {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }
  .form-status.form-status-success {
    color: #15803d;
  }
  .form-status.form-status-error {
    color: #dc2626;
  }

  .hp-field {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script is:inline define:vars={{ accessKey: import.meta.env.PUBLIC_WEB3FORMS_KEY, contactEmail: CONTACT_EMAIL }}>
  const form = document.getElementById('submit-form');
  const statusBox = document.getElementById('form-status');

  form.querySelectorAll('.consent-block input[type="checkbox"]').forEach((box) => {
    box.addEventListener('change', () => {
      const allConsented = Array.from(
        form.querySelectorAll('.consent-block input[type="checkbox"]')
      ).every((b) => b.checked);
      if (allConsented) document.getElementById('consent-error').textContent = '';
    });
  });

  function setFieldError(input, message) {
    const errorEl = document.getElementById(`${input.id}-error`);
    if (errorEl) errorEl.textContent = message;
    input.classList.toggle('field-invalid', Boolean(message));
  }

  function validate() {
    let ok = true;

    form.querySelectorAll('[data-required="true"]').forEach((field) => {
      if (field.type === 'checkbox') return; // consent handled as a group below
      if (!field.value.trim()) {
        setFieldError(field, 'Required');
        ok = false;
      } else if (field.type === 'email' && !field.checkValidity()) {
        setFieldError(field, 'Enter a valid email');
        ok = false;
      } else {
        setFieldError(field, '');
      }
    });

    const consentBoxes = form.querySelectorAll('.consent-block input[type="checkbox"]');
    const allConsented = Array.from(consentBoxes).every((box) => box.checked);
    const consentErrorEl = document.getElementById('consent-error');
    if (!allConsented) {
      consentErrorEl.textContent = 'Please check all four boxes above to continue.';
      ok = false;
    } else {
      consentErrorEl.textContent = '';
    }

    return ok;
  }

  function showStatus(message, kind) {
    statusBox.textContent = message;
    statusBox.className = `form-status form-status-${kind}`;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const honeypot = form.querySelector('#botcheck');
    if (honeypot && honeypot.value) {
      showStatus("Thanks — I'll review this and follow up if I have questions.", 'success');
      form.reset();
      return;
    }

    if (!validate()) {
      showStatus('Please fix the highlighted fields.', 'error');
      return;
    }

    const submitButton = form.querySelector('button[type="submit"]');
    submitButton.disabled = true;
    submitButton.textContent = 'Sending…';
    showStatus('', '');

    const payload = Object.fromEntries(new FormData(form).entries());
    payload.access_key = accessKey;
    payload.subject = `New email submission (${payload.category || 'uncategorized'})`;
    payload.replyto = payload.submitterEmail;

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      if (result.success) {
        showStatus("Thanks — I'll review this and follow up if I have questions.", 'success');
        form.reset();
      } else {
        throw new Error(result.message || 'Submission failed');
      }
    } catch (err) {
      showStatus(`Something went wrong — please try again, or email ${contactEmail} directly.`, 'error');
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Submit';
    }
  });
</script>
