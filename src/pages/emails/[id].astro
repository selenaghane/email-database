---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AnnotatedBody from '../../components/AnnotatedBody.astro';
import { withBase } from '../../lib/url';
import { getCategoryLabel, getApproachLabel } from '../../data/taxonomy';

export async function getStaticPaths() {
  const entries = await getCollection('emails');
  return entries.map((entry) => ({
    params: { id: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'emails'>;
}

const { entry } = Astro.props;
const { category, approach, context, annotations } = entry.data;
const body = entry.body;
---

<Base title={`${getCategoryLabel(category)} email — Email Library`}>
  <a href={withBase('')} class="text-sm text-gray-500 hover:underline">&larr; Back to all emails</a>

  <div class="mt-4 text-xs uppercase tracking-wide text-gray-500">
    {getCategoryLabel(category)} · {getApproachLabel(approach)}
  </div>

  <p class="mt-2 text-gray-700">{context}</p>

  <div class="mt-6 rounded-lg border border-gray-200 bg-gray-50 p-4">
    <AnnotatedBody body={body} annotations={annotations} />
  </div>
</Base>
